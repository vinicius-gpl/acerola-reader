{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "br.acerola.comic",
  "productName": "acerola",
  "version": "0.0.1",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "acerola",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 1124,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' acerola-reader: asset: https://asset.localhost http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "isolation-src"
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:acerola.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources":  [
      ".bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
