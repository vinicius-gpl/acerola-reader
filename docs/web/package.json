{
	"name": "acerola-docs",
	"version": "1.1.0",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "npm run paraglide:compile && vite dev",
		"build": "npm run paraglide:compile && vite build && pagefind --site build/prerendered --glob \"{pt-br.html,en.html,pt-br/**/*.html,en/**/*.html}\" --output-path build/client/pagefind",
		"preview": "vite preview",
		"start": "node build",
		"deploy:storybook": "npm run build-storybook && npx wrangler deploy --config wrangler.storybook.toml",
		"check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"paraglide:compile": "node scripts/i18n.mjs",
		"test": "npm run paraglide:compile && vitest run",
		"test:watch": "npm run paraglide:compile && vitest",
		"test:unit": "npm run paraglide:compile && vitest run --project=unit",
		"test:unit:watch": "npm run paraglide:compile && vitest --project=unit",
		"test:coverage": "npm run paraglide:compile && vitest run --coverage",
		"test:coverage:unit": "npm run paraglide:compile && vitest run --project=unit --coverage",
		"test:ui": "npm run paraglide:compile && vitest --ui",
		"test:storybook": "npm run paraglide:compile && vitest run --project=storybook",
		"test:storybook:watch": "npm run paraglide:compile && vitest --project=storybook",
		"storybook": "npm run paraglide:compile && storybook dev -p 6007",
		"build-storybook": "npm run paraglide:compile && storybook build",
		"test:mutation": "npm run paraglide:compile && svelte-kit sync && stryker run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/noto-serif": "^5.2.9",
		"@formkit/auto-animate": "^0.11.0",
		"@inlang/paraglide-js": "^3.2.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.79.0",
		"@playwright/test": "^1.65.1",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@storybook/addon-a11y": "^10.6.8",
		"@storybook/addon-docs": "^10.6.8",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.8",
		"@storybook/sveltekit": "^10.6.8",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "^5.1.1",
		"aws4fetch": "^1.0.20",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"gsap": "^3.15.1",
		"jsdom": "^31.0.1",
		"mdsvex": "^1.0.1",
		"mermaid": "^12.3.0",
		"pagefind": "^1.6.0",
		"playwright": "^1.62.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.6",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.6.0",
		"storybook": "^10.5.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
