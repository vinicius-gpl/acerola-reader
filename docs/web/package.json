{
  "name": "acerola-docs",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run paraglide:compile && vite dev",
    "build": "npm run paraglide:compile && vite build && pagefind --site .svelte-kit/cloudflare --output-subdir pagefind",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:storybook": "npm run build-storybook && npx wrangler deploy --config wrangler.storybook.toml",
    "check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "test": "npm run paraglide:compile && vitest run",
    "test:watch": "npm run paraglide:compile && vitest",
    "test:unit": "npm run paraglide:compile && vitest run --project=unit",
    "test:unit:watch": "npm run paraglide:compile && vitest --project=unit",
    "test:coverage": "npm run paraglide:compile && vitest run --coverage",
    "test:coverage:unit": "npm run paraglide:compile && vitest run --project=unit --coverage",
    "test:ui": "npm run paraglide:compile && vitest --ui",
    "test:storybook": "npm run paraglide:compile && vitest run --project=storybook",
    "test:storybook:watch": "npm run paraglide:compile && vitest --project=storybook",
    "storybook": "npm run paraglide:compile && storybook dev -p 6007",
    "build-storybook": "npm run paraglide:compile && storybook build",
    "test:mutation": "npm run paraglide:compile && svelte-kit sync && stryker run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/noto-serif": "^5.2.9",
    "@inlang/paraglide-js": "^2.15.2",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.34.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/sveltekit": "^10.5.10",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.3",
    "mermaid": "^11.17.1",
    "ogl": "^1.0.11",
    "pagefind": "^1.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2",
    "storybook": "^10.5.10",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.2"
  }
}
